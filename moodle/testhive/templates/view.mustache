<div class="mod-testhive-view">
    {{#intro}}
        <div class="activity-description mb-3">{{{intro}}}</div>
    {{/intro}}
    <div class="card">
        <div class="card-body">
            <dl class="row mb-0">
                {{#rows}}
                    <dt class="col-sm-4 col-lg-3">{{label}}</dt>
                    <dd class="col-sm-8 col-lg-9">{{#html}}{{{value}}}{{/html}}{{^html}}{{value}}{{/html}}</dd>
                {{/rows}}
            </dl>
            {{#launchurl}}
                <form class="mt-3 mb-0" method="post" action="{{launchurl}}">
                    <input type="hidden" name="sesskey" value="{{sesskey}}">
                    <input type="hidden" name="launch" value="1">
                    <button type="submit" class="btn btn-primary">{{startlabel}}</button>
                </form>
            {{/launchurl}}
            {{#syncurl}}
                <p class="mt-3 mb-0">
                    <a class="btn btn-secondary" href="{{syncurl}}">{{synclabel}}</a>
                </p>
            {{/syncurl}}
            {{#notice}}
                <div class="alert alert-info mt-3 mb-0" role="status">{{notice}}</div>
            {{/notice}}
        </div>
    </div>
    {{#showresults}}
        <div class="card mt-3">
            <div class="card-body">
                <h3 class="h5">{{resultheading}}</h3>
                <div class="table-responsive">
                    <table class="table table-sm generaltable">
                        <thead>
                            <tr>
                                <th scope="col">{{colstudent}}</th>
                                <th scope="col">{{colsubmitted}}</th>
                                <th scope="col">{{colevaluated}}</th>
                                <th scope="col">{{colscore}}</th>
                                <th scope="col">{{colpassed}}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#resultrows}}
                                <tr>
                                    <td>{{name}}</td>
                                    <td>{{submitted}}</td>
                                    <td>{{evaluated}}</td>
                                    <td>{{score}}</td>
                                    <td>{{passed}}</td>
                                </tr>
                            {{/resultrows}}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    {{/showresults}}
</div>
